SECRET_KEY=change-this-in-your-local-copy

# Neon (or any Postgres) connection string — required, no SQLite fallback
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudinary free-tier credentials — required for profile picture / review photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — app works fine without these using local fallbacks
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
WEATHER_API_KEY=
